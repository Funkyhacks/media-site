Date: Thu, 21 Aug 2026 00:00:00 +0000
Subject: [PATCH 5/6] config+main: flag weak/default JWT secret at startup

SECWEB_JWT_SECRET defaults to a 29-byte dev string and get_settings() never
validates it. PyJWT 2.13 already emits InsecureKeyLengthWarning (observed in
the test run). docker-compose requires the env var, but running
`uvicorn app.main:app` directly with the env unset silently falls back to the
known default, letting anyone who reads the source forge all users' identity
tokens. Add a config helper + a loud startup warning in create_app.

Refs: docs/SECURITY.md finding (JWT secret), THREAT-MODEL.md T8.

---
--- a/app/config.py
+++ b/app/config.py
@@ -62,6 +62,25 @@
     version: str = __version__
 
 
+# A known dev default is a hard footgun (anyone who reads the source can forge
+# tokens) and a short secret is a PyJWT InsecureKeyLengthWarning (RFC 7518
+# 3.2 recommends >=32 bytes for HS256). Both are flagged at startup.
+DEFAULT_JWT_SECRET = "dev-insecure-secret-change-me"
+MIN_JWT_SECRET_BYTES = 32
+
+
+def jwt_secret_problem(secret: str) -> Optional[str]:
+    """Return a human-readable problem with the JWT secret, or None if OK."""
+    if secret == DEFAULT_JWT_SECRET:
+        return ("SECWEB_JWT_SECRET is the insecure dev default — "
+                "set a random >=32-byte value")
+    n = len(secret.encode())
+    if n < MIN_JWT_SECRET_BYTES:
+        return (f"SECWEB_JWT_SECRET is {n} bytes (< {MIN_JWT_SECRET_BYTES} "
+                "recommended for HS256)")
+    return None
+
+
 def get_settings() -> Settings:
     """Build :class:`Settings` from the environment (or the test override)."""
     return Settings(

--- a/app/main.py
+++ b/app/main.py
@@ -16,6 +16,8 @@
 from contextlib import asynccontextmanager
 from typing import Optional
 
+import logging
+
 from fastapi import FastAPI
 
 from app import __version__

--- a/app/main.py
+++ b/app/main.py
@@ -67,6 +67,15 @@
         redoc_url=None,
     )
 
+    # Loud, greppable warning if the JWT secret is weak or the known default
+    # (SECURITY.md finding: JWT secret enforcement). Not fatal, but an operator
+    # running `uvicorn app.main:app` directly will see it immediately.
+    from app.config import jwt_secret_problem
+    _secret = (settings if settings is not None else get_settings()).jwt_secret
+    _issue = jwt_secret_problem(_secret)
+    if _issue is not None:
+        logging.getLogger("secweb").warning("JWT_SECRET: %s", _issue)
+
     # Injected instances win over environment-driven ones.
     if db is not None:
         app.state.db = db
