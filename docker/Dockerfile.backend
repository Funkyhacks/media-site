# SecWeb — multi-stage image for the FastAPI backend (SPEC.md §3).
# Python 3.12 slim, non-root, dependencies isolated in a cacheable layer.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# No apt packages are needed: the healthcheck uses the stdlib urllib.request
# (python -c ...) and every pip dep is a pure-Python wheel, so there is no build
# toolchain to install. (Previously curl was apt-get installed but is unused —
# removing it also clears the hadolint DL3008 "pin versions" finding.)

WORKDIR /app

# --- deps stage (cacheable) ---
FROM base AS deps
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# --- runtime stage ---
FROM base AS runtime
# non-root user (defense in depth; the image never needs root).
#
# UID/GID 1000 is a LOAD-BEARING CONTRACT, not a cosmetic choice:
#   * docker-compose.yml runs the `db` service (alpine) as a separate container
#     that seeds + chowns the shared `dbdata` volume to UID 1000, and gates the
#     api's startup on that ownership (see its healthcheck).
#   * If `useradd --system` assigned a *different* UID here, the api (running as
#     `secweb`) would fail to write secweb.db -> "attempt to write a readonly
#     database" (root-owned file on the volume).
# Keep this 1000 in lockstep with the `chown 1000:1000` in docker-compose.yml.
ARG SECWEB_UID=1000
ARG SECWEB_GID=1000
RUN groupadd --gid "$SECWEB_GID" secweb \
    && useradd --uid "$SECWEB_UID" --gid secweb --home-dir /app \
               --shell /usr/sbin/nologin secweb

COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

COPY app/ ./app/
RUN mkdir -p /app/storage /app/db \
    && chown -R secweb:secweb /app
USER secweb

EXPOSE 8000
# /api/health is the liveness probe target (see docker-compose healthcheck)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status==200 else 1)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
