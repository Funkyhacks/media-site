# SecWeb — multi-stage image for the FastAPI backend (SPEC.md §3).
# Python 3.12 slim, non-root, dependencies isolated in a cacheable layer.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# No apt packages are needed: the healthcheck uses the stdlib urllib.request
# (python -c ...) and every pip dep is a pure-Python wheel, so there is no build
# toolchain to install. (Previously curl was apt-get installed but is unused —
# removing it also clears the hadolint DL3008 "pin versions" finding.)

WORKDIR /app

# --- deps stage (cacheable) ---
FROM base AS deps
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# --- runtime stage ---
FROM base AS runtime
# non-root user (defense in depth; the image never needs root)
RUN groupadd --system secweb && useradd --system --gid secweb --home-dir /app secweb

COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

COPY app/ ./app/
RUN mkdir -p /app/storage \
    && chown -R secweb:secweb /app
USER secweb

EXPOSE 8000
# /api/health is the liveness probe target (see docker-compose healthcheck)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status==200 else 1)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
